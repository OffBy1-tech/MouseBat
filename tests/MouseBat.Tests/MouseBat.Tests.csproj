<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Only the logic that doesn't touch Windows or hardware, so tests run anywhere. -->
  <ItemGroup>
    <Compile Include="..\..\src\Battery.cs" Link="src\Battery.cs" />
    <Compile Include="..\..\src\HidppMouse.cs" Link="src\HidppMouse.cs" />
    <Compile Include="..\..\src\Updates.cs" Link="src\Updates.cs" />
  </ItemGroup>

</Project>
